+  // a bifurcated driver usable via /dev/infiniband without root).
+  if (getuid() != 0 && getenv("ERPC_ALLOW_NONROOT") == nullptr) {
+    rt_assert(false, "You need to be root to use eRPC (or set ERPC_ALLOW_NONROOT=1)");
+  }
 #endif
   rt_assert(rpc_id != kInvalidRpcId, "Invalid Rpc ID");
